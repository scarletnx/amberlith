;
; Each invocation takes its own word of storage buffer 0 and writes three times it plus its index 0x200 bytes on:
; integers only, so the processor's answer is exact on every machine (ounce/t_nvn2.c holds the buffer to it).
.stage compute
.local 64 1 1
        S2R R0, SR_TID.X                ; the invocation in its block
        S2R R1, SR_CTAID.X              ; the block in the dispatch
        SHF.L.U32 R1, R1, 6, RZ         ; 64 invocations a block
        IADD3 R0, R0, R1, RZ            ; the word's index
        SHF.L.U32 R3, R0, 2, RZ         ; its byte
        ULDC.64 UR4, c[0][0x310]        ; storage buffer 0's address, from the driver's table
        LDG.E R2, [R3 + UR4]
        IMAD R2, R2, 3, R0
        STG.E [R3 + UR4 + 0x200], R2
        EXIT
